{
  "air_power_electronic_warfare_tables": {
    "page_1": {
      "bjm_stand_off_jamming_table": {
        "columns": [
          "BJM Type",
          "Allowed Stand-Off Attacks (Pilot Only / Multi-Crew A/C)",
          "Angle-Off Coverage"
        ],
        "data": [
          {"BJM Type": "A", "Allowed Stand-Off Attacks": "1 / 1", "Angle-Off Coverage": "180+ and 30-"},
          {"BJM Type": "B", "Allowed Stand-Off Attacks": "2 / 2", "Angle-Off Coverage": "150+ and 60-"},
          {"BJM Type": "C", "Allowed Stand-Off Attacks": "2 / 3", "Angle-Off Coverage": "As B, or into any 3 adjacent arcs."},
          {"BJM Type": "D", "Allowed Stand-Off Attacks": "2 / 4", "Angle-Off Coverage": "As B, or into any angle-off arcs."}
        ],
        "formula": "Jamming Success Die Roll = BJM No. - Radar ECCM.",
        "notes": [
          "Noise Jamming Arcs = as for A, B, C above. Treat a BJM D as a C when noise jamming."
        ]
      },
      "bjm_programming_flexibility": {
        "columns": [
          "TYPE",
          "PROGRAMMING OPTIONS"
        ],
        "data": [
          {"TYPE": "A", "PROGRAMMING OPTIONS": "Pick Frequencies and Mode before play."},
          {"TYPE": "B", "PROGRAMMING OPTIONS": "Pilot Only: as \"A\". Multi-crew: may pick Frequencies and Mode during Aircraft Decisions Phase of game-turn."},
          {"TYPE": "C", "PROGRAMMING OPTIONS": "Pilot Only: as for Multi-crew above. Multi-crew: Same as above."},
          {"TYPE": "D", "PROGRAMMING OPTIONS": "Pilot Only and Multi-crew: may change Frequencies and Mode at start of SAM Interaction Phase."}
        ]
      },
      "ewr_passdown_modifiers": {
