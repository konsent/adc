        ],
        "modifiers": [
          "1. Crew Egressed over friendly territory = +2.",
          "2. Crew Egressed over enemy territory = -2.",
          "3. Dedicated search and rescue forces available = +2.",
          "4. Excellent fitness = +1. Poor fitness = -1.",
          "5. Excellent Confidence = +1. Poor Confidence = -1."
        ]
      }
